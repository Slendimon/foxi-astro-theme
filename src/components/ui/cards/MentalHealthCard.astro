---
// Mental Health Card
// ------------
// Description: Specialized card component for mental health content
// Properties:
// - Title: the title of the card
// - Subtitle: the subtitle of the card
// - Image: the main image of the card
// - Link: The link to the content
// - Type: 'test', 'resource', 'support', 'crisis', 'sensitive'
// - Duration: estimated time for tests
// - Badge: optional badge text
// - Urgent: boolean for urgent content

// Components
// - UI
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Card from './partials/Card.astro'
import CardBody from './partials/CardBody.astro'

// Props
type Props = {
	title?: string
	subtitle?: string
	image?: any
	link?: string
	type?: 'test' | 'resource' | 'support' | 'crisis' | 'sensitive'
	duration?: string
	badge?: string
	urgent?: boolean
}
const {
	title = '',
	subtitle,
	image,
	link,
	type = 'resource',
	duration,
	badge,
	urgent = false
} = Astro.props

// Type-specific styling (light theme only)
const typeStyles = {
	test: 'bg-blue-50 border-blue-200 hover:bg-blue-100',
	resource: 'bg-green-50 border-green-200 hover:bg-green-100',
	support: 'bg-purple-50 border-purple-200 hover:bg-purple-100',
	crisis: 'bg-red-50 border-red-200 hover:bg-red-100',
	sensitive: 'bg-yellow-50 border-yellow-200 hover:bg-yellow-100'
}

const iconMap = {
	test: 'lucide:brain-circuit',
	resource: 'lucide:book-open',
	support: 'lucide:heart-handshake',
	crisis: 'lucide:alert-triangle',
	sensitive: 'lucide:eye'
}

const iconColors = {
	test: 'text-blue-600',
	resource: 'text-green-600',
	support: 'text-purple-600',
	crisis: 'text-red-600',
	sensitive: 'text-yellow-600'
}
---

<Card classes={`mental-health-card ${typeStyles[type]} h-full transition-all duration-300 ease-out hover:shadow-lg hover:-translate-y-1 focus-within:ring-2 focus-within:ring-blue-500 focus-within:ring-offset-2 ${urgent ? 'ring-2 ring-red-300' : ''}`} link={link}>
    <div class="p-4" role="article" aria-labelledby={`card-title-${title.replace(/\s+/g, '-').toLowerCase()}`}>
		<!-- Icon Header -->
		<div class="flex items-center justify-between mb-3">
			<div class="flex items-center gap-3">
				<div class={`p-2 rounded-lg ${typeStyles[type].split(' ')[0]} border ${typeStyles[type].split(' ')[1]}`}>
					<Icon name={iconMap[type]} class={`w-6 h-6 ${iconColors[type]} flex-shrink-0`} aria-hidden="true" />
				</div>
				{badge && (
					<span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-white/80 text-gray-700 border border-gray-200" role="status" aria-label={`Categoría: ${badge}`}>
						{badge}
					</span>
				)}
			</div>
            {duration && (
                <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800" aria-label={`Duración estimada: ${duration}`}>
					<Icon name="lucide:clock" class="w-3 h-3 mr-1" aria-hidden="true" />
					<span class="sr-only">Duración:</span>
					{duration}
				</span>
			)}
		</div>

		<!-- Content -->
		<div class="space-y-2">
			<h3 class="text-base font-semibold text-gray-900 leading-tight" id={`card-title-${title.replace(/\s+/g, '-').toLowerCase()}`}>
				{title}
			</h3>
			<p class="text-sm text-gray-600 leading-relaxed line-clamp-3" aria-describedby={`card-title-${title.replace(/\s+/g, '-').toLowerCase()}`}>
				{subtitle}
			</p>
		</div>

		{urgent && (
			<div class="mt-3 p-2 bg-red-100 rounded-lg border border-red-200 animate-pulse" role="alert" aria-live="assertive">
				<p class="text-xs text-red-800 font-medium">
					<Icon name="lucide:alert-circle" class="w-3 h-3 inline mr-1" aria-hidden="true" />
					<span class="sr-only">Advertencia:</span>
					Contenido urgente - Busca ayuda profesional si es necesario
				</p>
			</div>
		)}
	</div>
</Card>

<style>
	/* Animaciones de entrada para los cards */
	.mental-health-card {
		animation: slideUpFadeIn 0.4s ease-out forwards;
		opacity: 0;
		transform: translateY(15px);
	}

	.mental-health-card:nth-child(1) { animation-delay: 0.1s; }
	.mental-health-card:nth-child(2) { animation-delay: 0.15s; }
	.mental-health-card:nth-child(3) { animation-delay: 0.2s; }
	.mental-health-card:nth-child(4) { animation-delay: 0.25s; }
	.mental-health-card:nth-child(5) { animation-delay: 0.3s; }
	.mental-health-card:nth-child(6) { animation-delay: 0.35s; }

	@keyframes slideUpFadeIn {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* Efectos hover suaves */
	.mental-health-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
	}

	/* Mejoras de accesibilidad */
	.mental-health-card:focus-visible {
		outline: 2px solid rgb(59, 130, 246);
		outline-offset: 2px;
	}

	/* Truncar texto largo */
	.line-clamp-3 {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Optimización para móviles */
	@media (max-width: 640px) {
		.mental-health-card {
			margin-bottom: 0.75rem;
		}

		.mental-health-card h3 {
			font-size: 0.95rem;
			line-height: 1.3;
		}

		.mental-health-card p {
			font-size: 0.8rem;
			line-height: 1.4;
		}

		.line-clamp-3 {
			-webkit-line-clamp: 2;
		}
	}

	/* Soporte para navegación por teclado */
	.mental-health-card a:focus-visible {
		outline: 2px solid rgb(59, 130, 246);
		outline-offset: 2px;
		border-radius: 0.5rem;
	}

	/* Reducción de movimiento para usuarios sensibles */
	@media (prefers-reduced-motion: reduce) {
		.mental-health-card {
			animation: none;
			opacity: 1;
			transform: none;
		}

		.mental-health-card:hover {
			transform: none;
		}
	}

	/* Alto contraste para mejor legibilidad */
	@media (prefers-contrast: high) {
		.mental-health-card {
			border-width: 2px;
		}
	}
</style>