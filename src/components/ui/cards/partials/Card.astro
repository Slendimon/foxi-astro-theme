---
// Card
// ------------
// Description: the basic card foundation. Contains the background, shadow and border radius
// Properties:
// - link: will allow the whole card to be linkable
// - classes: extra classes

// Props
type Props = {
	link?: string
	classes?: string
}
const { link, classes } = Astro.props
---

{
	link ? (
		<a 
			href={link} 
			class:list={['card', { [`${classes}`]: classes }]}
			target={link.startsWith('http') ? '_blank' : undefined}
			rel={link.startsWith('http') ? 'noopener noreferrer' : undefined}
		>
			<slot />
		</a>
	) : (
		<div class:list={['card', { [`${classes}`]: classes }]}>
			<slot />
		</div>
	)
}
<style>
	.card {
		@apply flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-white text-gray-600 shadow-lg shadow-gray-200/50;
	}
</style>
