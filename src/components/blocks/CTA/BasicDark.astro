---
// Basic Dark Call To Action section
// ------------
// Description: A centered call to action section that contains: a title, text, background image, notification and a button.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import CTA from '../../ui/CTA.astro'
import Button from '../../ui/Button.astro'
import ChipNotification from '../../ui/ChipNotification.astro'
import { Image } from 'astro:assets'
import Highlight from '../../ui/Highlight.astro'

// Content
import ctaImage from '../../../assets/cta-dark-bg.webp'
import badge from '../../../assets/badge.svg'
---

<Section>
	<Row>
		<Col span="1" />
		<Col span="10">
			<CTA
				title="¡Tu bienestar mental es importante!"
				text="Únete a cientos de estudiantes que ya están cuidando su salud mental con SAME. Accede a recursos validados, tests psicológicos y apoyo profesional cuando lo necesites."
				mode="dark"
				bg={ctaImage}
			>
				<ChipNotification radius="rounded-full" classes="mb-6 box">
					<Image src={badge} alt="Plataforma Validada" class="h-12 w-12" slot="button" />
					<span class="hidden md:block">Plataforma Validada por</span>
					<Highlight classes="md:ml-2"> Universidad Nacional Jorge Basadre Grohmann </Highlight>
				</ChipNotification>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<Button size="lg" style="primary" link="/tests">Realizar un Test</Button>
					<Button size="lg" style="neutral" link="/resources">Explorar Recursos</Button>
				</div>
			</CTA>
		</Col>
		<Col span="1" />
	</Row>
</Section>
