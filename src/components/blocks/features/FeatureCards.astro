---
// Feature Cards grid Section
// ------------
// Description: A grid of cards with feature information in a 4 column layout.

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import MentalHealthCard from '../../ui/cards/MentalHealthCard.astro'

// Content
// - Cards
import feature01 from '../../../assets/cards/feature-01.svg'
import feature02 from '../../../assets/cards/feature-02.svg'
import feature03 from '../../../assets/cards/feature-03.svg'
import feature04 from '../../../assets/cards/feature-04.svg'
import feature05 from '../../../assets/cards/feature-05.svg'
---

<Section id="features">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<h2 class="text-pretty">Recursos de <strong>Salud Mental</strong> SAME</h2>
			<p class="pb-0 text-lg">
				Accede a una amplia gama de recursos validados científicamente para mejorar tu bienestar mental y emocional durante tu vida universitaria en la UNJBG.
			</p>
		</Col>
	</Row>
	<Row>
		<Col span="4">
			<MentalHealthCard
				title="Tests Psicológicos Validados"
				subtitle="Evalúa tu estado mental con tests psicológicos validados científicamente. Obtén insights sobre ansiedad, depresión, estrés y otros aspectos del bienestar mental."
				image={feature01}
				link="/tests"
				type="test"
				badge="Evaluación"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<MentalHealthCard
				title="Blogs Educativos"
				subtitle="Lee artículos especializados sobre salud mental, técnicas de relajación, manejo del estrés académico y consejos para el bienestar estudiantil."
				image={feature02}
				link="/blog"
				type="resource"
				badge="Lectura"
			/>
			<MentalHealthCard
				title="Videos y Podcasts"
				subtitle="Accede a contenido multimedia educativo con expertos en psicología, meditaciones guiadas y charlas sobre salud mental universitaria."
				image={feature03}
				link="/resources"
				type="resource"
				badge="Multimedia"
			/>
		</Col>
		<Col span="4" classes="flex flex-col gap-6">
			<MentalHealthCard
				title="Centros de Apoyo"
				subtitle="Conecta con profesionales de la salud mental, centros de apoyo estudiantil y recursos de emergencia disponibles en tu universidad."
				image={feature04}
				link="/support"
				type="support"
				badge="Profesional"
			/>
			<MentalHealthCard
				title="Seguimiento Personalizado"
				subtitle="Monitorea tu progreso en salud mental con herramientas de seguimiento personalizadas y recomendaciones adaptadas a tus necesidades."
				image={feature05}
				link="/dashboard"
				type="resource"
				badge="Dashboard"
			/>
		</Col>
	</Row>
</Section>
