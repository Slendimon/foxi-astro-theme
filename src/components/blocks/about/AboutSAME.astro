---
// About SAME Project Section
// ------------
// Description: A section explaining the SAME project, its mission, and results

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import Button from '../../ui/Button.astro'
import { Image } from 'astro:assets'

// Icons
import Brain from '../../../icons/brain.svg'
import Rocket from '../../../icons/rocket.svg'
import DocumentChartBar from '../../../icons/document-chart-bar.svg'
import Scale from '../../../icons/scale.svg'
import Identification from '../../../icons/identification.svg'
import BellAlert from '../../../icons/bell-alert.svg'
import ShieldCheck from '../../../icons/shield-check.svg'
import Book from '../../../icons/book.svg'

// Content
// - Project Image
import frontis from '../../../assets/frontis_unjbg.jpeg'
---

<Section id="about" classes="py-16 bg-gradient-to-br from-blue-50 via-white to-yellow-50">
	<Row>
		<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
			<div class="flex items-center justify-center gap-4 mb-4">
				<Brain class="w-10 h-10 text-blue-600" />
				<h2 class="text-pretty text-3xl font-bold">Sobre el Proyecto <strong class="text-blue-600">SAME</strong></h2>
			</div>
			<p class="pb-0 text-lg text-gray-700 leading-relaxed">
				Salud Mental Estudiantil - Plataforma integradora para apoyar la tutoría universitaria en salud mental en la UNJBG.
			</p>
		</Col>
	</Row>

	<!-- Problema y Objetivo -->
	<Row classes="mb-12">
		<Col span="6">
			<div class="bg-white/80 backdrop-blur-sm border border-blue-100 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
				<div class="flex items-center gap-3 mb-4">
					<div class="p-3 bg-red-50 rounded-lg border border-red-200">
						<BellAlert class="w-6 h-6 text-red-600" />
					</div>
					<h3 class="text-xl font-bold text-gray-900">Problema Identificado</h3>
				</div>
				<p class="text-gray-700 leading-relaxed">
					No se cuenta con una plataforma integradora como apoyo a la tutoría en relación a la salud mental en la UNJBG.
				</p>
			</div>
		</Col>
		<Col span="6">
			<div class="bg-white/80 backdrop-blur-sm border border-green-100 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
				<div class="flex items-center gap-3 mb-4">
					<div class="p-3 bg-green-50 rounded-lg border border-green-200">
						<Rocket class="w-6 h-6 text-green-600" />
					</div>
					<h3 class="text-xl font-bold text-gray-900">Nuestro Objetivo</h3>
				</div>
				<p class="text-gray-700 leading-relaxed">
					Implementar una plataforma web de salud mental universitaria (SAME) en la tutoría de los estudiantes de la UNJBG.
				</p>
			</div>
		</Col>
	</Row>

	<!-- Estadísticas de Salud Mental -->
	<Row classes="mb-12">
		<Col span="12">
			<div class="bg-white/90 backdrop-blur-sm border border-yellow-100 rounded-xl p-8 shadow-lg">
				<div class="flex items-center justify-center gap-3 mb-6">
					<DocumentChartBar class="w-8 h-8 text-yellow-600" />
					<h3 class="text-2xl font-bold text-center text-gray-900">Cifras DIRESA Tacna</h3>
				</div>
				<div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
					<div class="text-center p-4 bg-blue-50 rounded-lg border border-blue-200">
						<div class="text-2xl font-bold text-blue-600 mb-1">19.46%</div>
						<div class="text-sm text-gray-600 font-medium">Ansiedad</div>
					</div>
					<div class="text-center p-4 bg-purple-50 rounded-lg border border-purple-200">
						<div class="text-2xl font-bold text-purple-600 mb-1">7.45%</div>
						<div class="text-sm text-gray-600 font-medium">Depresión</div>
					</div>
					<div class="text-center p-4 bg-orange-50 rounded-lg border border-orange-200">
						<div class="text-2xl font-bold text-orange-600 mb-1">4.67%</div>
						<div class="text-sm text-gray-600 font-medium">Alcohol</div>
					</div>
					<div class="text-center p-4 bg-red-50 rounded-lg border border-red-200">
						<div class="text-2xl font-bold text-red-600 mb-1">1.97%</div>
						<div class="text-sm text-gray-600 font-medium">Drogas</div>
					</div>
				</div>
				<div class="text-center mt-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
					<p class="text-sm text-gray-700 font-medium">954 atenciones • 19 intentos de suicidio</p>
				</div>
			</div>
		</Col>
	</Row>

	<!-- Imagen y Datos del Proyecto -->
	<Row classes="mb-12 items-center">
		<Col span="6">
			<div class="relative rounded-xl overflow-hidden shadow-2xl">
				<Image
					src={frontis}
					alt="Universidad Nacional Jorge Basadre Grohmann"
					class="w-full h-80 object-cover"
					format="webp"
				/>
				<div class="absolute inset-0 bg-gradient-to-b from-yellow-400/20 to-transparent pointer-events-none"></div>
				<div class="absolute inset-0 bg-gradient-to-t from-yellow-400/20 to-transparent pointer-events-none"></div>
			</div>
		</Col>
		<Col span="6">
			<div class="grid grid-cols-2 gap-4">
				<div class="bg-white/80 backdrop-blur-sm border border-green-100 rounded-lg p-4 text-center shadow-lg">
					<Scale class="w-8 h-8 text-green-600 mx-auto mb-2" />
					<div class="text-xl font-bold text-green-600">S/149,540</div>
					<div class="text-xs text-gray-600">Presupuesto</div>
				</div>
				<div class="bg-white/80 backdrop-blur-sm border border-blue-100 rounded-lg p-4 text-center shadow-lg">
					<Book class="w-8 h-8 text-blue-600 mx-auto mb-2" />
					<div class="text-xl font-bold text-blue-600">24 meses</div>
					<div class="text-xs text-gray-600">Duración</div>
				</div>
				<div class="bg-white/80 backdrop-blur-sm border border-purple-100 rounded-lg p-4 text-center shadow-lg">
					<ShieldCheck class="w-8 h-8 text-purple-600 mx-auto mb-2" />
					<div class="text-xl font-bold text-purple-600">Oct 2024</div>
					<div class="text-xs text-gray-600">Inicio</div>
				</div>
				<div class="bg-white/80 backdrop-blur-sm border border-yellow-100 rounded-lg p-4 text-center shadow-lg">
					<div class="text-sm font-bold text-yellow-600">Canon Minero</div>
					<div class="text-xs text-gray-600">Financiamiento</div>
				</div>
			</div>
		</Col>
	</Row>

	<!-- Equipo de Investigación -->
	<Row classes="mb-8">
		<Col span="12">
			<div class="bg-white/90 backdrop-blur-sm border border-indigo-100 rounded-xl p-8 shadow-lg">
				<div class="flex items-center justify-center gap-3 mb-6">
					<Identification class="w-8 h-8 text-indigo-600" />
					<h3 class="text-2xl font-bold text-center text-gray-900">Equipo de Investigación</h3>
				</div>
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
					<div>
						<h4 class="font-semibold text-lg mb-4 text-blue-600 flex items-center gap-2">
							<Brain class="w-5 h-5" />
							Investigadores Principales
						</h4>
						<ul class="space-y-2 text-sm text-gray-700">
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></span>
								Dra. María del Carmen Silva Cornejo (Principal)
							</li>
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></span>
								Mgr. Luis Pastor Yañez
							</li>
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></span>
								Dra. Giselle Aleman Espinoza
							</li>
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 flex-shrink-0"></span>
								Dr. Luis Alfredo Fernández Vizcarra
							</li>
						</ul>
					</div>
					<div>
						<h4 class="font-semibold text-lg mb-4 text-green-600 flex items-center gap-2">
							<ShieldCheck class="w-5 h-5" />
							Equipo de Apoyo
						</h4>
						<ul class="space-y-2 text-sm text-gray-700">
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-green-600 rounded-full mt-2 flex-shrink-0"></span>
								Dra. Ingrid Manrique Tejada
							</li>
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-green-600 rounded-full mt-2 flex-shrink-0"></span>
								Dr. Nicolás Nuñez Morales (Colaborador)
							</li>
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-green-600 rounded-full mt-2 flex-shrink-0"></span>
								Lic. Maricielo Gutiérrez Otero (Asistente)
							</li>
							<li class="flex items-start gap-2">
								<span class="w-1.5 h-1.5 bg-green-600 rounded-full mt-2 flex-shrink-0"></span>
								Bach. Yuliana Coaquera Mamani (Gestora)
							</li>
						</ul>
					</div>
				</div>
			</div>
		</Col>
	</Row>

	<!-- Call to Action -->
	<Row>
		<Col span="12" align="center">
			<div class="flex flex-col sm:flex-row gap-4 justify-center">
				<Button size="lg" link="/proyecto" style="primary">Ver Proyecto Completo</Button>
				<Button size="lg" link="/tests" style="neutral">Realizar Tests</Button>
			</div>
		</Col>
	</Row>
</Section>
