---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
import Section from '../components/ui/Section.astro'
import Row from '../components/ui/Row.astro'
import Col from '../components/ui/Col.astro'
// - UI
import Button from '../components/ui/Button.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'
import SAMEContactForm from '../components/blocks/contact/SAMEContactForm.astro'

// Icons
import Phone from '../icons/phone-arrow-up-right.svg'
import ShieldCheck from '../icons/shield-check.svg'
import Heart from '../icons/brain.svg'
import BellAlert from '../icons/bell-alert.svg'

// Content
// - SEO
const SEO = {
	title: 'SAME | Contacto y Apoyo en Salud Mental',
	description:
		'¿Necesitas apoyo emocional? Contacta con SAME para recursos de salud mental estudiantil, líneas de ayuda en Perú y soporte profesional. Línea 100, servicios locales en Tacna y más.'
}
// - Page Header
const header = {
	title: 'Tu Bienestar Mental es <strong>Nuestra Prioridad</strong>',
	text: "En SAME estamos aquí para apoyarte. Si necesitas ayuda inmediata, recursos educativos o simplemente alguien con quien hablar, no estás solo. Busca el apoyo que necesitas."
}
---

<Layout title={SEO.title} description={SEO.description}>
	<section class="bg-gradient-to-br from-blue-50 via-white to-green-50 py-16 relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-r from-blue-400/10 to-green-400/10"></div>
		<div class="container mx-auto px-6 relative">
			<div class="max-w-4xl mx-auto text-center mb-16">
				<div class="flex justify-center mb-6">
					<Heart class="w-16 h-16 text-blue-600" />
				</div>
				<h1 class="text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
					{header.title}
				</h1>
				<p class="text-xl text-gray-700 leading-relaxed">
					{header.text}
				</p>
				<div class="mt-8 p-4 bg-yellow-50 border border-yellow-200 rounded-lg max-w-2xl mx-auto">
					<p class="text-yellow-800 font-medium">
						<BellAlert class="w-5 h-5 inline mr-2" />
						Si estás en crisis o necesitas ayuda inmediata, llama a emergencias antes de usar este formulario.
					</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Contactos de Emergencia y Apoyo -->
	<Section classes="py-16 bg-white">
		<Row>
			<Col span="12" align="center" classes="mb-12 max-w-4xl mx-auto">
				<h2 class="text-3xl font-bold text-gray-900 mb-4">Líneas de Ayuda y Contactos de Apoyo</h2>
				<p class="text-lg text-gray-600">
					Servicios profesionales disponibles 24/7 en Perú. No dudes en buscar ayuda cuando la necesites.
				</p>
			</Col>
		</Row>
		<Row classes="gap-8">
			<Col span="3">
				<div class="bg-red-50 border border-red-200 rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
					<div class="flex justify-center mb-4">
						<Phone class="w-12 h-12 text-red-600" />
					</div>
					<h3 class="text-xl font-bold text-red-800 mb-2">Emergencias</h3>
					<p class="text-red-700 mb-4">Llamada gratuita las 24 horas</p>
					<div class="text-2xl font-bold text-red-600 mb-4">911</div>
					<p class="text-sm text-red-600">Para situaciones de riesgo inmediato</p>
				</div>
			</Col>
			<Col span="3">
				<div class="bg-blue-50 border border-blue-200 rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
					<div class="flex justify-center mb-4">
						<ShieldCheck class="w-12 h-12 text-blue-600" />
					</div>
					<h3 class="text-xl font-bold text-blue-800 mb-2">Línea Salud Mental MINSA</h3>
					<p class="text-blue-700 mb-4">Ministerio de Salud del Perú</p>
					<div class="text-2xl font-bold text-blue-600 mb-4">113 opción 5</div>
					<p class="text-sm text-blue-600">Apoyo psicológico especializado</p>
				</div>
			</Col>
			<Col span="3">
				<div class="bg-green-50 border border-green-200 rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
					<div class="flex justify-center mb-4">
						<Heart class="w-12 h-12 text-green-600" />
					</div>
					<h3 class="text-xl font-bold text-green-800 mb-2">DBUN UNJBG-PSICOLOGÍA</h3>
					<p class="text-green-700 mb-4">Universidad Nacional Jorge Basadre Grohmann</p>
					<div class="text-lg font-bold text-green-600 mb-2">052-583000 Anexo 3020</div>
					<p class="text-sm text-green-600">Apoyo psicológico universitario</p>
				</div>
			</Col>
			<Col span="3">
				<div class="bg-purple-50 border border-purple-200 rounded-xl p-6 text-center shadow-lg hover:shadow-xl transition-shadow duration-300 h-full">
					<div class="flex justify-center mb-4">
						<BellAlert class="w-12 h-12 text-purple-600" />
					</div>
					<h3 class="text-xl font-bold text-purple-800 mb-2">Proyecto SAME</h3>
					<p class="text-purple-700 mb-4">Contacto del Proyecto</p>
					<div class="text-lg font-bold text-purple-600 mb-2">disam@unjbg.edu.pe</div>
					<p class="text-sm text-purple-600">Información y coordinación</p>
				</div>
			</Col>
		</Row>

		<!-- Correos Electrónicos de Contacto -->
		<Row classes="mt-8">
			<Col span="12">
				<div class="bg-white/90 backdrop-blur-sm border border-gray-200 rounded-xl p-6 shadow-lg">
					<h3 class="text-xl font-bold text-center text-gray-900 mb-4">Correos Electrónicos de Contacto</h3>
					<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
						<div class="text-center p-4 bg-blue-50 rounded-lg border border-blue-200">
							<h4 class="font-semibold text-blue-800 mb-1">Dirección de Bienestar Universitario (DBUN)</h4>
							<p class="text-blue-600">dbun@unjbg.edu.pe</p>
						</div>
						<div class="text-center p-4 bg-green-50 rounded-lg border border-green-200">
							<h4 class="font-semibold text-green-800 mb-1">DBUN - Psicología</h4>
							<p class="text-green-600">lrivash@unjbg.edu.pe</p>
						</div>
						<div class="text-center p-4 bg-purple-50 rounded-lg border border-purple-200">
							<h4 class="font-semibold text-purple-800 mb-1">Proyecto SAME</h4>
							<p class="text-purple-600">disam@unjbg.edu.pe</p>
						</div>
					</div>
				</div>
			</Col>
		</Row>

		<Row classes="mt-8">
			<Col span="12" align="center">
				<div class="bg-gradient-to-r from-blue-50 to-green-50 border border-blue-200 rounded-lg p-6 max-w-3xl mx-auto">
					<h3 class="text-lg font-bold text-gray-900 mb-2">Recuerda:</h3>
					<p class="text-gray-700">
						Buscar ayuda profesional es un signo de fortaleza, no de debilidad. Todos merecemos apoyo en nuestra salud mental.
						Si necesitas hablar con alguien de confianza, nuestros recursos están disponibles para ti.
					</p>
					<div class="mt-4 flex flex-col sm:flex-row gap-4 justify-center">
						<Button style="primary" link="/tests" size="base">Realizar Test de Salud Mental</Button>
						<Button style="neutral" link="/resources" size="base">Explorar Recursos</Button>
					</div>
				</div>
			</Col>
		</Row>
	</Section>

	<!-- Formulario de Contacto -->
	<section class="py-16 bg-gray-50">
		<div class="container mx-auto px-6">
			<div class="max-w-2xl mx-auto">
				<SAMEContactForm />
			</div>
		</div>
	</section>

	<CTA />
</Layout>
