---
// Appointments Page
// ------------
// Description: Page for booking mental health counseling appointments

// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import AppointmentBooking from '../components/blocks/appointments/AppointmentBooking.astro'
import MentalHealthCard from '../components/ui/cards/MentalHealthCard.astro'
import Button from '../components/ui/Button.astro'

// - SEO
const SEO = {
	title: 'Sistema de Citas | SAME - UNJBG',
	description:
		'Agenda tu cita de consejería psicológica en línea. Sistema gratuito para estudiantes UNJBG con psicólogos especializados en salud mental estudiantil.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<!-- Hero Section -->
	<section class="bg-mental-lavender-50 dark:bg-mental-lavender-950/30 py-16">
		<div class="container mx-auto px-6">
			<div class="max-w-4xl mx-auto text-center">
				<h1 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-6">
					Sistema de <span class="text-mental-lavender-600">Citas en Línea</span>
				</h1>
				<p class="text-xl text-gray-600 dark:text-gray-300 mb-8">
					Agenda tu sesión de consejería psicológica de manera fácil y segura.
					Servicio gratuito para todos los estudiantes de la UNJBG.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<!-- <Button size="lg" link="#booking" style="primary">Agendar Cita</Button> -->
					<Button size="lg" link="/support" style="neutral">Ver Centros de Apoyo</Button>
				</div>
			</div>
		</div>
	</section>

	<!-- Benefits Section -->
	<section class="py-16">
		<div class="container mx-auto px-6">
			<div class="max-w-4xl mx-auto">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">
						¿Por qué usar nuestro sistema de citas?
					</h2>
					<p class="text-gray-600 dark:text-gray-300">
						Beneficios de agendar tu cita en línea
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-6">
					<MentalHealthCard
						title="Fácil y Rápido"
						subtitle="Agenda tu cita en menos de 5 minutos desde cualquier dispositivo. Proceso simple e intuitivo."
						type="support"
						badge="Conveniente"
					/>
					<MentalHealthCard
						title="Totalmente Gratuito"
						subtitle="Servicio 100% gratuito para estudiantes UNJBG. Sin costos ocultos ni cargos adicionales."
						type="support"
						badge="Gratuito"
					/>
					<MentalHealthCard
						title="Profesionales Especializados"
						subtitle="Psicólogos con experiencia en salud mental estudiantil y desafíos académicos específicos."
						type="support"
						badge="Expertos"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- Booking Section -->
	<section id="booking" class="py-16 bg-gray-50 dark:bg-gray-900">
		<div class="container mx-auto px-6">
			<div class="max-w-2xl mx-auto">
				<AppointmentBooking />
			</div>
		</div>
	</section>

	<!-- Information Section -->
	<section class="py-16">
		<div class="container mx-auto px-6">
			<div class="max-w-4xl mx-auto">
				<div class="grid md:grid-cols-2 gap-12">
					<div>
						<h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
							Información sobre las Citas
						</h2>
						<div class="space-y-4">
							<div class="flex items-start gap-3">
								<div class="w-6 h-6 bg-mental-lavender-100 dark:bg-mental-lavender-900/50 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
									<svg class="w-3 h-3 text-mental-lavender-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-gray-900 dark:text-gray-100">Duración de las Sesiones</h3>
									<p class="text-sm text-gray-600 dark:text-gray-300">50 minutos por sesión individual</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div class="w-6 h-6 bg-mental-lavender-100 dark:bg-mental-lavender-900/50 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
									<svg class="w-3 h-3 text-mental-lavender-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-gray-900 dark:text-gray-100">Modalidades Disponibles</h3>
									<p class="text-sm text-gray-600 dark:text-gray-300">Presencial y virtual según tu preferencia</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<div class="w-6 h-6 bg-mental-lavender-100 dark:bg-mental-lavender-900/50 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
									<svg class="w-3 h-3 text-mental-lavender-600" fill="currentColor" viewBox="0 0 20 20">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
									</svg>
								</div>
								<div>
									<h3 class="font-semibold text-gray-900 dark:text-gray-100">Confirmación</h3>
									<p class="text-sm text-gray-600 dark:text-gray-300">Recibirás confirmación por correo en 24-48 horas</p>
								</div>
							</div>
						</div>
					</div>
					<div>
						<h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
							Tipos de Consulta
						</h2>
						<div class="space-y-4">
							<div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
								<h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Consejería Individual</h3>
								<p class="text-sm text-gray-600 dark:text-gray-300">Sesiones personalizadas para abordar tus necesidades específicas</p>
							</div>
							<div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
								<h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Estrés Académico</h3>
								<p class="text-sm text-gray-600 dark:text-gray-300">Estrategias para manejar la presión académica y mejorar el rendimiento</p>
							</div>
							<div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
								<h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Ansiedad y Depresión</h3>
								<p class="text-sm text-gray-600 dark:text-gray-300">Apoyo especializado para trastornos del estado de ánimo</p>
							</div>
							<div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4">
								<h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">Orientación Vocacional</h3>
								<p class="text-sm text-gray-600 dark:text-gray-300">Ayuda para tomar decisiones sobre tu futuro profesional</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-16 bg-mental-lavender-50 dark:bg-mental-lavender-950/30">
		<div class="container mx-auto px-6">
			<div class="max-w-2xl mx-auto text-center">
				<h2 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-6">
					¿Necesitas ayuda inmediata?
				</h2>
				<p class="text-gray-600 dark:text-gray-300 mb-8">
					Si estás en una situación de crisis, no esperes. Contacta inmediatamente
					con nuestra línea de crisis 24/7.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<Button size="lg" link="/support#crisis" style="danger">Línea de Crisis 24/7</Button>
					<Button size="lg" link="tel:911" style="neutral">911 Emergencias</Button>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Animaciones específicas para esta página */
	section {
		animation: fadeInUp 0.6s ease-out forwards;
		opacity: 0;
		transform: translateY(20px);
	}

	section:nth-child(1) { animation-delay: 0.1s; }
	section:nth-child(2) { animation-delay: 0.2s; }
	section:nth-child(3) { animation-delay: 0.3s; }
	section:nth-child(4) { animation-delay: 0.4s; }
	section:nth-child(5) { animation-delay: 0.5s; }

	@keyframes fadeInUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>