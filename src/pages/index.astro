---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/HomeCTA.astro'
import Features from '../components/blocks/features/FeatureCards.astro'
import MentalHealthTests from '../components/blocks/tests/MentalHealthTests.astro'
import MentalHealthResources from '../components/blocks/resources/MentalHealthResources.astro'
import SupportCenters from '../components/blocks/support/SupportCenters.astro'
import AboutSAME from '../components/blocks/about/AboutSAME.astro'
import WellnessTips from '../components/blocks/tips/WellnessTips.astro'
import StudentTestimonials from '../components/blocks/testimonials/StudentTestimonials.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Content
// - Testimonial background
import testimonialBackground from '../assets/testimonial-bg-01.webp'
// - SEO
const SEO = {
	title: 'SAME - Salud Mental Estudiantil UNJBG',
	description:
		'SAME es la plataforma integral de salud mental para estudiantes de la UNJBG. Ofrecemos tests psicológicos validados, recursos educativos, centros de apoyo y seguimiento personalizado para mejorar el bienestar mental estudiantil.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero />
	<AboutSAME />
	<MentalHealthTests />
	<MentalHealthResources />
	<WellnessTips />
	<SupportCenters />
</Layout>
