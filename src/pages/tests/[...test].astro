---
// Dynamic Test Page
// ------------
// Description: Dynamic page for all mental health tests

// Components
// - Layout
import Layout from '../../layouts/Layout.astro'
// - UI
import { Image } from 'astro:assets'
import Button from '../../components/ui/Button.astro'
import MentalHealthCard from '../../components/ui/cards/MentalHealthCard.astro'
import { TEST_DATA } from '../../data/tests'

export function getStaticPaths() {
	return Object.keys(TEST_DATA).map(testSlug => ({
		params: { test: testSlug }
	}))
}

const { test } = Astro.params
const testParam = Array.isArray(test) ? test[0] : test
const isValidTest = typeof testParam === 'string' && testParam in TEST_DATA

if (!isValidTest) {
	return new Response(null, {
		status: 302,
		headers: { Location: '/tests' }
	})
}

// - SEO
const testInfo = TEST_DATA[testParam]
const SEO = {
	title: `${testInfo.fullName} | SAME - UNJBG`,
	description: testInfo.description
}
---

<Layout title={SEO.title} description={SEO.description}>
	<!-- Modern Hero Section -->
	<section class="relative overflow-hidden">
		<div class="absolute inset-0 bg-gradient-to-br from-mental-blue-50 via-mental-blue-50 to-primary-50"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-mental-blue-600/5 to-primary-600/5"></div>
		<div class="relative container mx-auto px-6 py-20">
			<div class="max-w-5xl mx-auto">
				<div class="grid lg:grid-cols-2 gap-12 items-center">
					<div class="text-center lg:text-left">
						<div class="inline-flex items-center justify-center w-20 h-20 bg-mental-blue-100 rounded-2xl mb-8 mx-auto lg:mx-0">
							<svg class="w-10 h-10 text-mental-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
							</svg>
						</div>
						<h1 class="text-4xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
							Test de <span class="text-transparent bg-clip-text bg-gradient-to-r from-mental-blue-600 to-primary-600">{testInfo.fullName}</span>
							<br><span class="text-3xl lg:text-4xl font-semibold text-mental-blue-700">{testInfo.name}</span>
						</h1>
						<p class="text-xl text-gray-600 mb-8 leading-relaxed">
							{testInfo.description}
						</p>
						<div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
							<Button size="lg" style="primary" classes="shadow-lg hover:shadow-xl transition-shadow">Comenzar Test</Button>
							<Button size="lg" link="/tests" style="neutral">← Ver Otros Tests</Button>
						</div>
					</div>
					<div class="relative">
						<div class="bg-white rounded-3xl shadow-2xl p-8 border border-mental-blue-100">
							<div class="text-center">
								<div class="w-16 h-16 bg-mental-blue-100 rounded-2xl flex items-center justify-center mx-auto mb-4">
									<svg class="w-8 h-8 text-mental-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
									</svg>
								</div>
								<h3 class="text-lg font-semibold text-gray-900 mb-2">Test Validado</h3>
								<p class="text-sm text-gray-600 mb-4">{testInfo.questions} preguntas • {testInfo.duration}</p>
								<div class="flex justify-center space-x-2">
									<span class="px-3 py-1 bg-mental-blue-100 text-mental-blue-700 rounded-full text-xs font-medium">Científico</span>
									<span class="px-3 py-1 bg-mental-green-100 text-mental-green-700 rounded-full text-xs font-medium">Anónimo</span>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Information Cards Section -->
	<section class="py-16 bg-white">
		<div class="container mx-auto px-6">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-12">
					<h2 class="text-3xl font-bold text-gray-900 mb-4">¿Qué es el {testInfo.name}?</h2>
					<p class="text-lg text-gray-600 max-w-3xl mx-auto">
						{testInfo.description} Este instrumento está validado científicamente y es ampliamente utilizado por profesionales de la salud mental.
					</p>
				</div>

				<div class="grid md:grid-cols-3 gap-8 mb-12">
					<!-- Card 1 -->
					<div class="bg-gradient-to-br from-mental-blue-50 to-mental-blue-100 rounded-2xl p-6 border border-mental-blue-200 hover:shadow-lg transition-all duration-300">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-mental-blue-500 rounded-xl flex items-center justify-center mr-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
								</svg>
							</div>
							<h3 class="text-lg font-semibold text-mental-blue-900">Evaluación Rápida</h3>
						</div>
						<p class="text-mental-blue-700">Test de {testInfo.questions} preguntas que identifica síntomas en solo {testInfo.duration}.</p>
					</div>

					<!-- Card 2 -->
					<div class="bg-gradient-to-br from-mental-green-50 to-mental-green-100 rounded-2xl p-6 border border-mental-green-200 hover:shadow-lg transition-all duration-300">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-mental-green-500 rounded-xl flex items-center justify-center mr-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
								</svg>
							</div>
							<h3 class="text-lg font-semibold text-mental-green-900">Validado Científicamente</h3>
						</div>
						<p class="text-mental-green-700">Basado en criterios diagnósticos validados y utilizado en la práctica clínica internacional.</p>
					</div>

					<!-- Card 3 -->
					<div class="bg-gradient-to-br from-mental-lavender-50 to-mental-lavender-100 rounded-2xl p-6 border border-mental-lavender-200 hover:shadow-lg transition-all duration-300">
						<div class="flex items-center mb-4">
							<div class="w-12 h-12 bg-mental-lavender-500 rounded-xl flex items-center justify-center mr-4">
								<svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
								</svg>
							</div>
							<h3 class="text-lg font-semibold text-mental-lavender-900">100% Confidencial</h3>
						</div>
						<p class="text-mental-lavender-700">Tus respuestas son completamente anónimas y se procesan con la máxima privacidad y seguridad.</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Instructions Section -->
	<section class="py-16 bg-gradient-to-br from-slate-50 to-gray-100">
		<div class="container mx-auto px-6">
			<div class="max-w-4xl mx-auto">
				<div class="bg-white rounded-3xl shadow-xl p-8 lg:p-12 border border-gray-200">
					<div class="text-center mb-8">
						<h2 class="text-3xl font-bold text-gray-900 mb-4">Instrucciones</h2>
						<p class="text-lg text-gray-600">
							Responde cada pregunta considerando cómo te has sentido durante
							<span class="font-semibold text-mental-blue-600">las últimas 2 semanas</span>
						</p>
					</div>

					<div class="grid md:grid-cols-2 gap-8">
						<div class="space-y-6">
							<div class="bg-mental-blue-50 rounded-xl p-6 border border-mental-blue-200">
								<h3 class="text-lg font-semibold text-mental-blue-900 mb-4 flex items-center">
									<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4"></path>
									</svg>
									Escala de Respuestas
								</h3>
								<div class="space-y-2 text-sm">
									<div class="flex justify-between items-center py-1">
										<span class="text-mental-blue-800">0 = Nada en absoluto</span>
									</div>
									<div class="flex justify-between items-center py-1">
										<span class="text-mental-blue-800">1 = Varios días</span>
									</div>
									<div class="flex justify-between items-center py-1">
										<span class="text-mental-blue-800">2 = Más de la mitad de los días</span>
									</div>
									<div class="flex justify-between items-center py-1">
										<span class="text-mental-blue-800">3 = Casi todos los días</span>
									</div>
								</div>
							</div>
						</div>

						<div class="space-y-6">
							<div class="bg-mental-green-50 rounded-xl p-6 border border-mental-green-200">
								<h3 class="text-lg font-semibold text-mental-green-900 mb-4 flex items-center">
									<svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
									Recomendaciones
								</h3>
								<ul class="space-y-2 text-sm text-mental-green-800">
									<li class="flex items-start">
										<svg class="w-4 h-4 mr-2 mt-0.5 text-mental-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
										</svg>
										Responde honestamente
									</li>
									<li class="flex items-start">
										<svg class="w-4 h-4 mr-2 mt-0.5 text-mental-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
										</svg>
										No hay respuestas correctas/incorrectas
									</li>
									<li class="flex items-start">
										<svg class="w-4 h-4 mr-2 mt-0.5 text-mental-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
										</svg>
										Busca ayuda profesional si es necesario
									</li>
								</ul>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 bg-gradient-to-r from-mental-blue-600 to-primary-600">
		<div class="container mx-auto px-6">
			<div class="max-w-3xl mx-auto text-center">
				<h2 class="text-3xl lg:text-4xl font-bold text-white mb-6">
					¿Listo para comenzar tu evaluación?
				</h2>
				<p class="text-xl text-mental-blue-100 mb-8 leading-relaxed">
					Tu bienestar mental es importante. Este test te ayudará a entender mejor tu estado y te proporcionará recomendaciones personalizadas.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<Button size="lg" style="primary" classes="bg-white text-mental-blue-600 hover:bg-mental-blue-50 shadow-lg">Iniciar Test {testInfo.name}</Button>
					<Button size="lg" link="/support" style="neutral" classes="border-white text-white hover:bg-white hover:text-mental-blue-600">Necesito Ayuda Ahora</Button>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	/* Animaciones específicas para esta página */
	section {
		animation: fadeInUp 0.6s ease-out forwards;
		opacity: 0;
		transform: translateY(20px);
	}

	section:nth-child(1) { animation-delay: 0.1s; }
	section:nth-child(2) { animation-delay: 0.2s; }
	section:nth-child(3) { animation-delay: 0.3s; }
	section:nth-child(4) { animation-delay: 0.4s; }

	@keyframes fadeInUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>