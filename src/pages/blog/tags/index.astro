---
// Blog Tags Page
// ------------
// Description: The blog tags page.

// Components
// - Layout
import Layout from '../../../layouts/Layout.astro'
// - UI
import Hero from '../../../components/blocks/hero/PageHeader.astro'
import BlogPosts from '../../../components/blocks/blog/BlogPosts.astro'

// Data
import { getCollection } from 'astro:content'
const allPosts = await getCollection('blog')
---

<Layout title="Etiquetas del Blog - SAME" description="Explora todas las etiquetas y categorías de artículos sobre salud mental estudiantil en el blog de SAME.">
	<Hero title="Etiquetas del Blog" text="Descubre artículos organizados por temas relacionados con la salud mental universitaria." />
	<BlogPosts data={allPosts} />
</Layout>
