---
// Components
// - Layout
import Layout from '../layouts/Layout.astro'
// - UI
import Hero from '../components/blocks/hero/PageHeader.astro'
import FAQ from '../components/blocks/FAQ/FaqSticky.astro'
import TextImage from '../components/blocks/basic/TextImage.astro'
import CTA from '../components/blocks/CTA/BasicDark.astro'

// Data
import faqData from '../data/json-files/faqData.json'
// - FAQ Categories
const faqPricing = faqData.filter((faq) => faq.category === 'pricing')
const faqIntegrations = faqData.filter((faq) => faq.category === 'integrations')

// Content
import faqImage1 from '../assets/faq/faq-01.png'
// - SEO
const SEO = {
	title: 'SAME | Preguntas Frecuentes sobre Salud Mental',
	description:
		'Encuentra respuestas a las preguntas más comunes sobre salud mental, tests psicológicos, recursos disponibles y cómo acceder al apoyo profesional en SAME.'
}
// - Page Header
const header = {
	title: 'Preguntas Frecuentes sobre <strong>SAME</strong>',
	text: 'Encuentra respuestas a las preguntas más comunes sobre salud mental, nuestros servicios y recursos disponibles.'
}
---

<Layout title={SEO.title} description={SEO.description}>
	<Hero title={header.title} text={header.text} />
	<FAQ
		title="Tests Psicológicos y Evaluaciones"
		text="Información sobre nuestros tests validados, cómo interpretarlos y cuándo buscar ayuda profesional basada en los resultados."
		data={faqPricing}
	/>
	<TextImage
		title="¿Por qué SAME es valioso para tu salud mental?"
		text="SAME ofrece recursos gratuitos y accesibles para todos los estudiantes de la UNJBG. Nuestros servicios están diseñados para proporcionar apoyo integral en salud mental, desde evaluaciones hasta recursos educativos y conexión con profesionales especializados."
		image={faqImage1}
		mobileImage={faqImage1}
		imagePosition="left"
		offsetImage
		classes="bg-mental-blue-50 dark:bg-mental-blue-950/30 lg:!py-64"
	/>
	<FAQ
		title="Recursos y Apoyo Disponible"
		text="Conoce los diferentes tipos de recursos disponibles en SAME, desde blogs educativos hasta centros de apoyo profesional y herramientas de seguimiento personalizadas."
		data={faqIntegrations}
	/>
	<CTA />
</Layout>
